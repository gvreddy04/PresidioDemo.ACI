<?xml version="1.0" encoding="utf-8"?>
<!--
  PNR recognizers in the Presidio-style format (WR-014): a flat list under <recognizers> that mirrors Presidio's
  recognizer registry YAML, its analyze allow_list and its anonymizers map, using Presidio's names.
  Each decoded string is decided on its own: a string that matches an <allow_list> item end to end is published
  unchanged; otherwise every span detected at or above default_score_threshold gets its entity's <anonymizer>, else
  DEFAULT, else Presidio's replace; a string in which nothing is detected is published unchanged and listed for review.
  Every result keeps the string's width (WR-015). Values below are made up.
-->
<recognizers feed="PNR" language="en" default_score_threshold="0.5">

  <!-- ===== Predefined recognizers (Presidio's own). All of them run unless switched off by class name, for example:
       <recognizer name="CryptoRecognizer" type="predefined" enabled="false" />  ===== -->

  <!-- ===== Custom pattern recognizers (Presidio type: custom). ===== -->

  <!-- Example: 261109140 -> *********. -->
  <recognizer name="creationTime" type="custom" supported_entity="UNCLASSIFIED_IDENTIFIER">
    <pattern name="nine digits" score="0.85">^\d{9}$</pattern>
  </recognizer>

  <!-- Example: MILLER/JORDAN MR -> ****************. Presidio's PERSON misses this format. -->
  <recognizer name="passengerName" type="custom" supported_entity="PERSON">
    <pattern name="surname/given" score="0.9">(?&lt;![A-Z])[A-Z]{2,}(?:[ '-][A-Z]+)*/[A-Z]*(?:[ '-][A-Z]+)*</pattern>
  </recognizer>

  <!-- Example: in ONE*MBR JORDAN MILLER*ACCT ..., JORDAN MILLER -> *************. -->
  <recognizer name="memberName" type="custom" supported_entity="PERSON">
    <pattern name="after MBR" score="0.9">(?&lt;=MBR )[A-Z]+(?: [A-Z]+)*(?=\*)</pattern>
    <context>MBR</context>
  </recognizer>

  <!-- DOCS: type/issuing country/document number/nationality/date of birth/gender/expiry/name. -->
  <!-- Example: in DOCSDAHK1/P/USA/X1234567/USA/12MAR85/F/09NOV31/MILLER/JORDAN, 12MAR85 -> *******. -->
  <recognizer name="dateOfBirth" type="custom" supported_entity="DATE_OF_BIRTH">
    <pattern name="DOCS birth date" score="0.9">(?&lt;=/)\d{2}[A-Z]{3}\d{2}(?=/[MFUX]I?/)</pattern>
    <context>DOCS</context>
  </recognizer>
  <recognizer name="gender" type="custom" supported_entity="GENDER">
    <pattern name="DOCS gender" score="0.9">(?&lt;=/\d{2}[A-Z]{3}\d{2}/)[MFUX]I?(?=/)</pattern>
  </recognizer>
  <recognizer name="docsIssuingCountry" type="custom" supported_entity="SENSITIVE_ATTRIBUTE">
    <pattern name="DOCS issuing country" score="0.85">(?&lt;=DOCS[A-Z0-9]{2}HK\d/[A-Z]{1,2}/)[A-Z]{2,3}(?=/)</pattern>
  </recognizer>
  <recognizer name="docsDocumentNumber" type="custom" supported_entity="UNCLASSIFIED_IDENTIFIER">
    <pattern name="DOCS document number" score="0.85">(?&lt;=DOCS[A-Z0-9]{2}HK\d/[A-Z]{0,2}/[A-Z]{0,3}/)[A-Z0-9]{3,20}(?=/)</pattern>
  </recognizer>
  <recognizer name="docsNationality" type="custom" supported_entity="SENSITIVE_ATTRIBUTE">
    <pattern name="DOCS nationality" score="0.85">(?&lt;=DOCS[A-Z0-9]{2}HK\d/[A-Z]{0,2}/[A-Z]{0,3}/[A-Z0-9]{0,20}/)[A-Z]{2,3}(?=/)</pattern>
  </recognizer>
  <recognizer name="docsExpiry" type="custom" supported_entity="SENSITIVE_ATTRIBUTE">
    <pattern name="DOCS expiry" score="0.85">(?&lt;=/[MFUX]I?/)\d{2}[A-Z]{3}\d{2}(?=/)</pattern>
  </recognizer>

  <!-- Contacts. Example: in CTCEDAHK1/JORDAN.MILLER//EXAMPLE.COM, the address is masked. -->
  <recognizer name="ctceEmail" type="custom" supported_entity="EMAIL_ADDRESS">
    <pattern name="CTCE address" score="0.9">(?&lt;=CTCE[A-Z0-9]{2}HK\d/)[A-Z0-9._%+]+(?:-[A-Z0-9._%+]+)*//[A-Z0-9-]+(?:\.[A-Z0-9-]+)*\.[A-Z]{2,}</pattern>
  </recognizer>
  <recognizer name="requestedEmail" type="custom" supported_entity="EMAIL_ADDRESS">
    <pattern name="after EMAIL RQSTD" score="0.9">(?&lt;=EMAIL RQSTD )\S+</pattern>
  </recognizer>
  <!-- Example: in CTCMDAHK1/15555550142, 15555550142 -> ***********. -->
  <recognizer name="ctcmPhone" type="custom" supported_entity="PHONE_NUMBER">
    <pattern name="CTCM number" score="0.9">(?&lt;=CTCM[A-Z0-9]{2}HK\d/)\d{6,15}</pattern>
  </recognizer>

  <!-- Tickets, loyalty, payment and references. -->
  <recognizer name="ticketNumber" type="custom" supported_entity="TICKET_REFERENCE">
    <pattern name="TKNE ticket" score="0.85">(?&lt;=\.)\d{13,14}(?=C\d)</pattern>
    <pattern name="fare record ticket" score="0.85">(?&lt;=/)\d{11,15}(?=/)</pattern>
  </recognizer>
  <!-- Example: DA12345678 -> ##########. -->
  <recognizer name="loyaltyNumber" type="custom" supported_entity="LOYALTY_NUMBER">
    <pattern name="airline + digits" score="0.85">(?&lt;![0-9])[A-Z]{2}\d{6,12}(?!\d)</pattern>
  </recognizer>
  <recognizer name="loyaltyStatus" type="custom" supported_entity="SENSITIVE_ATTRIBUTE">
    <pattern name="tier after number" score="0.85">(?&lt;=[A-Z]{2}\d{6,12}\.\d\*)[A-Z][A-Z ]*</pattern>
    <pattern name="tier after ACCT" score="0.85">(?&lt;=ACCT [A-Z]{2}\d{6,12}\*)[A-Z]{1,4}(?=\*)</pattern>
  </recognizer>
  <recognizer name="accountBalance" type="custom" supported_entity="FINANCIAL_INFORMATION">
    <pattern name="after BALANCE" score="0.85">(?&lt;=BALANCE )\d+</pattern>
  </recognizer>
  <recognizer name="cardSuffix" type="custom" supported_entity="PAYMENT_REFERENCE">
    <pattern name="after XXXX" score="0.85">(?&lt;=X{4})\d{4}$</pattern>
  </recognizer>
  <recognizer name="approvalCode" type="custom" supported_entity="PAYMENT_REFERENCE">
    <pattern name="after APPR CC" score="0.85">(?&lt;=APPR CC [A-Z]{2} )\d{4,8}</pattern>
  </recognizer>
  <recognizer name="orderId" type="custom" supported_entity="ORDER_ID">
    <pattern name="after ORDERID or FQID" score="0.85">(?&lt;=(?:ORDERID|FQID)\*)[A-Z0-9-]+</pattern>
  </recognizer>
  <recognizer name="msoId" type="custom" supported_entity="UNCLASSIFIED_IDENTIFIER">
    <pattern name="after MSO ID" score="0.85">(?&lt;=MSO ID - )\d+</pattern>
  </recognizer>
  <recognizer name="rviId" type="custom" supported_entity="UNCLASSIFIED_IDENTIFIER">
    <pattern name="after RVI ID" score="0.85">(?&lt;=RVI ID\*)[A-Z0-9-]+</pattern>
  </recognizer>
  <recognizer name="address" type="custom" supported_entity="ADDRESS">
    <pattern name="ADDR remark" score="0.85">(?&lt;=^ADDR(?:CITY|STATE|ZIP)? ).+</pattern>
  </recognizer>

  <!-- ===== Allow list: a decoded string that matches an item end to end is published unchanged. ===== -->
  <!-- Examples: 09NOV26, 1405, FQTR, TOTAL FARE - USD412.50. -->
  <allow_list match="regex">
    <item>^\d{2}[A-Z]{3}\d{2}(?:\d{2})?$</item>
    <item>^\d{4}$</item>
    <item>^FQT[RS]$</item>
    <item>^TOTAL FARE - [A-Z]{3}[0-9.]+$</item>
  </allow_list>

  <!-- ===== Anonymizers (Presidio anonymizers map): one action per entity. ===== -->
  <!-- Allowed types: mask, replace, redact, hash, keep; every result is fitted to the width it replaces (WR-015). -->
  <anonymizer entity="PERSON" type="mask" masking_char="*" />
  <anonymizer entity="DATE_OF_BIRTH" type="mask" masking_char="*" />
  <anonymizer entity="GENDER" type="mask" masking_char="*" />
  <anonymizer entity="EMAIL_ADDRESS" type="mask" masking_char="*" />
  <anonymizer entity="PHONE_NUMBER" type="mask" masking_char="*" />
  <anonymizer entity="UNCLASSIFIED_IDENTIFIER" type="mask" masking_char="*" />
  <anonymizer entity="TICKET_REFERENCE" type="mask" masking_char="*" />
  <anonymizer entity="PAYMENT_REFERENCE" type="mask" masking_char="*" />
  <anonymizer entity="ORDER_ID" type="mask" masking_char="*" />
  <anonymizer entity="ADDRESS" type="mask" masking_char="*" />
  <!-- # keeps literal * record separators distinguishable (WR-005). -->
  <anonymizer entity="SENSITIVE_ATTRIBUTE" type="mask" masking_char="#" />
  <anonymizer entity="LOYALTY_NUMBER" type="mask" masking_char="#" />
  <anonymizer entity="FINANCIAL_INFORMATION" type="mask" masking_char="#" />
  <!-- Every other entity, including Presidio's CREDIT_CARD, IP_ADDRESS and LOCATION.
       Without this line Presidio's default applies: replace with <ENTITY>. -->
  <anonymizer entity="DEFAULT" type="mask" masking_char="#" />

</recognizers>
