<?xml version="1.0" encoding="utf-8"?>
<!--
  ACI recognizers in the Presidio-style format (WR-014): a flat list under <recognizers> that mirrors Presidio's
  recognizer registry YAML, its analyze allow_list and its anonymizers map, using Presidio's names.
  Scope: passenger names only. The file defines the one PERSON recognizer below; every other ACI value (loyalty
  numbers, record references and the rest) is published as received.
  Presidio:DefaultDetection (appsettings.json, default false) decides whether Presidio's predefined recognizers run too:
    false: only the recognizer defined here acts; Presidio's predefined recognizers (email, phone, credit card, IP,
           IBAN, spaCy PERSON, LOCATION, NRP, DATE_TIME and the rest) do not run. Example: in
           DA12345678 MILLER/JORDAN, only MILLER/JORDAN is masked.
    true:  the recognizer defined here acts, plus Presidio's predefined recognizers (minus any switched off below);
           their spans get their entity's <anonymizer>, else DEFAULT. Example: alex@example.com -> ****************.
  Each decoded string is decided on its own: a string that matches an <allow_list> item end to end is published
  unchanged; otherwise every span detected at or above default_score_threshold gets its entity's <anonymizer>, else
  DEFAULT, else Presidio's replace; a string in which nothing is detected is published unchanged and listed for review.
  Every result keeps the string's width (WR-015). Values below are made up.
-->
<recognizers feed="ACI" language="en" default_score_threshold="0.5">

  <!-- ===== Predefined recognizers (Presidio's own). They run only with Presidio:DefaultDetection true, and then all of them
       run unless switched off by class name, for example:
       <recognizer name="CryptoRecognizer" type="predefined" enabled="false" />  ===== -->

  <!-- ===== Custom pattern recognizers (Presidio type: custom): passenger names. ===== -->

  <!-- Example: MILLER/JORDAN -> *************, MILLER-SMITH/ANN MARIE -> **********************. Presidio's PERSON misses
       this format. -->
  <recognizer name="passengerName" type="custom" supported_entity="PERSON">
    <pattern name="surname/given" score="0.9">(?&lt;![A-Z])[A-Z]{2,}(?:[ '-][A-Z]+)*/[A-Z]*(?:[ '-][A-Z]+)*</pattern>
  </recognizer>

  <!-- ===== Allow list: a decoded string that matches an item end to end is published unchanged. ===== -->
  <!-- Examples: 20261109, 20261109 14.05.33.120, 14.05.33.120, 3412 (aircraft number), B12 or " C7" (gate),
       UNKNOWN or the truncated UNKNOW (process name), **** (already masked upstream). The items stop no recognizer defined
       above; they are kept for Presidio:DefaultDetection true, where Presidio's DATE_TIME and other guesses would otherwise
       change such strings. -->
  <allow_list match="regex">
    <item>^\d{8}$</item>
    <item>^\d{8} \d{2}\.\d{2}\.\d{2}\.\d{3}$</item>
    <item>^\d{2}\.\d{2}\.\d{2}\.\d{3}$</item>
    <item>^\d{4}$</item>
    <item>^ ?[A-Z]\d{1,3}$</item>
    <item>^UNKNOWN?$</item>
    <item>^\*+$</item>
  </allow_list>

  <!-- ===== Anonymizers (Presidio anonymizers map): one action per entity. ===== -->
  <!-- Allowed types: mask, replace, redact, hash, keep; every result is fitted to the width it replaces (WR-015). -->
  <anonymizer entity="PERSON" type="mask" masking_char="*" />
  <!-- Every other entity: with Presidio:DefaultDetection true, Presidio's EMAIL_ADDRESS, CREDIT_CARD, IP_ADDRESS,
       LOCATION and the rest. Without this line Presidio's default applies: replace with <ENTITY>. -->
  <anonymizer entity="DEFAULT" type="mask" masking_char="*" />

</recognizers>
